      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(\n  (1 - avg by(instance, job)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100\n  + on(instance, job) group_left(nodename) (0 * max by(instance, job, nodename)(node_uname_info))\n)\nor\n(\n  (1 - avg by(instance, job)(rate(windows_cpu_time_total{mode=\"idle\"}[5m]))) * 100\n  + on(instance, job) group_left(nodename) (0 * label_replace(max by(instance, job, hostname)(windows_cs_hostname), \"nodename\", \"$1\", \"hostname\", \"(.+)\"))\n)",
          "hide": false,
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(\n  max by(instance, job)((1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100)\n  + on(instance, job) group_left(nodename) (0 * max by(instance, job, nodename)(node_uname_info))\n)\nor\n(\n  max by(instance, job)((1 - windows_os_physical_memory_free_bytes / windows_cs_physical_memory_bytes) * 100)\n  + on(instance, job) group_left(nodename) (0 * label_replace(max by(instance, job, hostname)(windows_cs_hostname), \"nodename\", \"$1\", \"hostname\", \"(.+)\"))\n)",
          "hide": false,
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(\n  max by(instance, job)((1 - node_filesystem_avail_bytes{mountpoint=\"/data\"} / node_filesystem_size_bytes{mountpoint=\"/data\"}) * 100)\n  + on(instance, job) group_left(nodename) (0 * max by(instance, job, nodename)(node_uname_info))\n)\nor\n(\n  max by(instance, job)((1 - windows_logical_disk_free_bytes{volume=\"C:\"} / windows_logical_disk_size_bytes{volume=\"C:\"}) * 100)\n  + on(instance, job) group_left(nodename) (0 * label_replace(max by(instance, job, hostname)(windows_cs_hostname), \"nodename\", \"$1\", \"hostname\", \"(.+)\"))\n)",
          "hide": false,
          "instant": false,
          "legendFormat": "__auto",
          "range": true,
          "refId": "C"
        },
